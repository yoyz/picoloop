include Makefile_sources

# PSVita target. Builds inside the vitasdk container
# (docker.io/vitasdk/vitasdk) - see doc/psvita/build.md. Same shape as the other
# Makefile.PatternPlayer_* files; the VPK packaging needs the vita-toolchain
# binaries, which the image provides ($VITASDK).
.PHONY: all package clean

CC    := arm-vita-eabi-g++
STRIP := arm-vita-eabi-strip

PROJECT_TITLE   := PicoloopPSVita
PROJECT_TITLEID := PICOLOOP1
PROJECT         := picoloop_vita


# Same five engines the Vita target has always enabled. The LGPT sampler is
# PSVITA-only in practice: Master.h sets __RAM512MIB__ for PSVITA, which makes
# main() call init_lgpt_samplepool().
SYNTH=
SYNTH+= -DENABLE_SYNTH_PICOSYNTH
SYNTH+= -DENABLE_SYNTH_PICODRUM
SYNTH+= -DENABLE_SYNTH_OPL2
SYNTH+= -DENABLE_SYNTH_PBSYNTH
SYNTH+= -DENABLE_SYNTH_LGPTSAMPLER


CFLAGS_SDLVERS=-D__SDL20__

CFLAGS=
CFLAGS+= -std=c++11 -O2
CFLAGS+= -I. -I$(VITASDK)/arm-vita-eabi/include
CFLAGS+= ${CFLAGS_SDLVERS}
CFLAGS+= -fpermissive
CFLAGS+= -Wpointer-arith
CFLAGS+= ${SYNTH}

CFLAGS+= -DPSVITA
CFLAGS+= -D__PSVITA_AUDIO__
# DPRINTF is only defined for PSVITA when DEBUGPRINTF==1 (it routes to
# sceClibPrintf); without it every DPRINTF() use fails to compile.
CFLAGS+= -DDEBUGPRINTF=1

CXXFLAGS= $(CFLAGS)


LIBS=
LIBS+= -L. -L$(VITASDK)/arm-vita-eabi/lib
LIBS+= -lSDL2_ttf
LIBS+= -lfreetype
LIBS+= -lpng
LIBS+= -lz
LIBS+= -lbz2
LIBS+= -lSDL2
LIBS+= -lvitaGL
LIBS+= -lvitashark
LIBS+= -lmathneon
LIBS+= -lSceShaccCgExt
LIBS+= -ltaihen_stub
LIBS+= -lSceShaccCg_stub
LIBS+= -lSceKernelDmacMgr_stub
LIBS+= -lSceAudio_stub
LIBS+= -lSceAudioIn_stub
LIBS+= -lSceMotion_stub
LIBS+= -lSceIme_stub
LIBS+= -lvita2d
LIBS+= -lvita2d_vgl
LIBS+= -lSceGxm_stub
LIBS+= -lSceDisplay_stub
LIBS+= -lSceCtrl_stub
LIBS+= -lSceSysmodule_stub
LIBS+= -lSceCommonDialog_stub
LIBS+= -lpsp2shell
LIBS+= -lSceNet_stub
LIBS+= -lSceNetCtl_stub
LIBS+= -lSceLibKernel_stub
LIBS+= -lScePower_stub
LIBS+= -lSceAppMgr_stub
LIBS+= -lSceTouch_stub
LIBS+= -lSceHid_stub


SOURCES=	\
			SYSTEMPSVITA.cpp	\
			AudioDriverPSVita.cpp   \
			$(SOURCES_PICOLOOP)     \
			$(SOURCES_PICOSYNTH) \
			$(SOURCES_PICOSYNTHUI) \
			$(SOURCES_PICODRUM) \
			$(SOURCES_PICODRUMUI) \
			$(SOURCES_DBOPL) \
			$(SOURCES_DBOPLUI) \
			$(SOURCES_PBSYNTH) \
			$(SOURCES_PBSYNTHUI) \
			$(SOURCES_LGPTSAMPLERSYNTH) \
			$(SOURCES_LGPTSAMPLERSYNTHUI)


OBJDIR             =     out
OBJECTS            =   $(SOURCES:.cpp=.o)
OBJECTSINOBJDIR    = $(addprefix $(OBJDIR)/,$(OBJECTS))

EXECUTABLE=$(PROJECT).vpk

# samples/*.wav are optional: init_lgpt_samplepool() loads them from
# ux0:/app/PICOLOOP1/samples/ at runtime, but SamplePool::loadSample() just
# logs and skips missing files, so a build without them still works.
SAMPLE_FILES := $(wildcard samples/*.wav)
VPK_SAMPLES  := $(foreach f,$(SAMPLE_FILES),--add $(f)=$(f))


all: $(EXECUTABLE)


package: $(EXECUTABLE)

$(EXECUTABLE): eboot.bin param.sfo
	vita-pack-vpk -s param.sfo -b eboot.bin \
		--add font.ttf=font.ttf \
		$(VPK_SAMPLES) \
		--add sce_sys/icon0.png=sce_sys/icon0.png \
		--add sce_sys/livearea/contents/bg.png=sce_sys/livearea/contents/bg.png \
		--add sce_sys/livearea/contents/startup.png=sce_sys/livearea/contents/startup.png \
		--add sce_sys/livearea/contents/template.xml=sce_sys/livearea/contents/template.xml \
		$(EXECUTABLE)

eboot.bin: $(PROJECT).velf
	vita-make-fself $(PROJECT).velf eboot.bin

param.sfo:
	vita-mksfoex -s TITLE_ID="$(PROJECT_TITLEID)" "$(PROJECT_TITLE)" param.sfo

$(PROJECT).velf: $(PROJECT).elf
	$(STRIP) -g $<
	vita-elf-create $< $@

$(PROJECT).elf: $(OBJECTSINOBJDIR)
	$(CC) -Wl,-q -o $@ $^ $(LIBS)

$(OBJDIR)/%.o : %.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) -c $(CXXFLAGS) -o $@ $<


clean:
	-rm -f $(PROJECT).velf $(PROJECT).elf $(EXECUTABLE) param.sfo eboot.bin
	-rm -f $(OBJECTSINOBJDIR)
	-rm -rf $(OBJDIR)
