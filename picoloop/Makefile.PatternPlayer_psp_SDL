include Makefile_sources

# PSP (pspdev toolchain) target. pspdev's $(PSPSDK)/lib/build.mak supplies the
# compile/link rules; this file only has to provide OBJS/CFLAGS/LIBS and the
# EBOOT settings, in the same shape as the other Makefile.PatternPlayer_* files.
TARGET          = picoloop
EXTRA_TARGETS   = EBOOT.PBP
PSP_EBOOT_TITLE = picoloop

BUILD_PRX       = 1
PSP_FW_VERSION  = 500


# 32 MB of RAM: each MonoMixer allocates one instance of every enabled
# machine and there are four MonoMixers, so only the four light engines are
# enabled here. Keep this list in sync with SOURCES below.
SYNTH=
SYNTH+= -DENABLE_SYNTH_PICOSYNTH
SYNTH+= -DENABLE_SYNTH_PICODRUM
SYNTH+= -DENABLE_SYNTH_OPL2
SYNTH+= -DENABLE_SYNTH_PBSYNTH


CFLAGS_SDLVERS=-D__SDL12__

CFLAGS=
CFLAGS+= -std=c++11
CFLAGS+= -O3 -G0 -Wall
CFLAGS+= -I${PSPDEV}/psp/include
CFLAGS+= -L${PSPDEV}/psp/lib
CFLAGS+= ${CFLAGS_SDLVERS}
CFLAGS+= -fpermissive
CFLAGS+= ${SYNTH}
CFLAGS+= -DPSP
CFLAGS+= -D__SDL_AUDIO__
CFLAGS+= -DDEBUGPRINTF

CXXFLAGS= $(CFLAGS)
ASFLAGS= $(CFLAGS)


# PatternPlayer.cpp provides its own main() and PSP_MODULE_INFO(), so libSDLmain
# must not be linked: it would add a second module_info and rename main to
# SDL_main. Hence sdl-config --libs minus -lSDLmain (and no -Dmain=SDL_main).
LIBS=
LIBS+= -lSDL_ttf
LIBS+= -lfreetype
LIBS+= -lpng
LIBS+= -lz
LIBS+= -lbz2
LIBS+= -lpspvfpu
LIBS+= -lstdc++
LIBS+= -lm
LIBS+= $(filter-out -lSDLmain,$(shell ${PSPDEV}/psp/bin/sdl-config --libs))


SOURCES=	\
			psp_callback.cpp	\
			AudioDriverSDL.cpp       \
			SYSTEMLINUX.cpp	       \
			$(SOURCES_PICOLOOP)     \
			$(SOURCES_PICOSYNTH) \
			$(SOURCES_PICOSYNTHUI) \
			$(SOURCES_PICODRUM) \
			$(SOURCES_PICODRUMUI) \
			$(SOURCES_DBOPL) \
			$(SOURCES_DBOPLUI) \
			$(SOURCES_PBSYNTH) \
			$(SOURCES_PBSYNTHUI)


OBJS= $(SOURCES:.cpp=.o)


PSPSDK = $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
