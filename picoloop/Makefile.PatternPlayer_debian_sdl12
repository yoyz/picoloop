include Makefile_sources

# Targets below are command names, not files - always run them even if a
# stray file with the same name exists in the tree.
.PHONY: all clean

CC=g++

SYNTH=
SYNTH+= -DENABLE_SYNTH_PICOSYNTH
SYNTH+= -DENABLE_SYNTH_PICODRUM
SYNTH+= -DENABLE_SYNTH_OPL2
SYNTH+= -DENABLE_SYNTH_PBSYNTH
SYNTH+= -DENABLE_SYNTH_LGPTSAMPLER
SYNTH+= -DENABLE_SYNTH_CURSYNTH
SYNTH+= -DENABLE_SYNTH_OPEN303
SYNTH+= -DENABLE_SYNTH_TWYTCHSYNTH
SYNTH+= -DENABLE_SYNTH_MDADRUM
SYNTH+= -DENABLE_SYNTH_SIDSYNTH
SYNTH+= -DENABLE_SYNTH_MIDIOUT
SYNTH+= -DENABLE_SYNTH_ER1


CFLAGS_SDLVERS=-D__SDL12__

CFLAGS=
CFLAGS+= -c -std=c++11 -O3
CFLAGS+= -I. -LSDL/lib
CFLAGS+= ${CFLAGS_SDLVERS}
CFLAGS+= ${SYNTH}
CFLAGS+= -ggdb

CFLAGS+= -D__LINUX__
CFLAGS+= -DLINUX
CFLAGS+= -D__SDL_AUDIO__
CFLAGS+= -DPC_DESKTOP
CFLAGS+= -DDEBUGPRINTF
CFLAGS+= -DSCREEN_MULT=2
CFLAGS+= -Werror=return-type


LDGLAGS=
LDFLAGS+=-lasound
LDFLAGS+=-lSDL
LDFLAGS+=-lSDL_ttf
LDFLAGS+=-lpthread


OBJTOLINK=


SOURCES=	\
			RtMidi.cpp		\
			AudioDriverSDL.cpp       \
			SYSTEMLINUX.cpp	       \
			SysMutex.cpp	       \
			MidiOutSystem.cpp	       \
			MidiInSystem.cpp	       \
			PicoloopIni.cpp	       \
			EmbeddedAssets.cpp	       \
			$(SOURCES_PICOLOOP)     \
			$(SOURCES_PICOSYNTH) \
			$(SOURCES_PICOSYNTHUI) \
			$(SOURCES_PICODRUM) \
			$(SOURCES_PICODRUMUI) \
			$(SOURCES_DBOPL) \
			$(SOURCES_DBOPLUI) \
			$(SOURCES_PBSYNTH) \
			$(SOURCES_PBSYNTHUI) \
			$(SOURCES_CURSYNTH) \
			$(SOURCES_CURSYNTHUI) \
			$(SOURCES_OPEN303) \
			$(SOURCES_OPEN303UI) \
			$(SOURCES_TWYTCH) \
			$(SOURCES_TWYTCHUI) \
			$(SOURCES_MIDIOUT) \
			$(SOURCES_MIDIOUTUI) \
			$(SOURCES_MDADRUM) \
			$(SOURCES_MDADRUMUI) \
			$(SOURCES_SIDSYNTH) \
			$(SOURCES_SIDSYNTHUI) \
			$(SOURCES_LGPTSAMPLERSYNTH) \
			$(SOURCES_LGPTSAMPLERSYNTHUI) \
			$(SOURCES_ER1) \
			$(SOURCES_ER1UI) 


OBJDIR             =     debian_sdl12
OBJECTS            =   $(SOURCES:.cpp=.o)
DEPENDENCY         =   $(SOURCES:.cpp=.d)

DEPENDENCYINOBJDIR = $(addprefix $(OBJDIR)/,$(DEPENDENCY))
OBJECTSINOBJDIR    = $(addprefix $(OBJDIR)/,$(OBJECTS))
OBJTOLINKINOBJDIR  = $(addprefix $(OBJDIR)/,$(OBJTOLINK))

EXECUTABLE=picoloop_${OBJDIR}

all: $(DEPENDENCYINOBJDIR) $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(DEPENDENCYINOBJDIR) $(OBJECTSINOBJDIR)
	$(CC) $(OBJTOLINKINOBJDIR)  $(OBJECTSINOBJDIR) -o $@ $(LDFLAGS)

# the .d file contain the dependency
$(OBJDIR)/%.d : %.cpp %.h
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM -MT '$(OBJDIR)/$*.o' $< -o $@

$(OBJDIR)/%.o : %.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS) $< -o $@


# include all the dependency .d file into the makefile 
# it allow to match change in .h file
-include $(DEPENDENCYINOBJDIR)


# SYSTEMLINUX.d does have a .h which is SYSTEM.h, so it need a tweaks
$(OBJDIR)/SYSTEMLINUX.d:SYSTEMLINUX.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM -MT '$(OBJDIR)/SYSTEMLINUX.o' $< -o $@

# PatternPlayer.d does have a .h which is system.h
$(OBJDIR)/PatternPlayer.d:PatternPlayer.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM -MT '$(OBJDIR)/PatternPlayer.o' $< -o $@


clean:
	-rm -f $(OBJECTSINOBJDIR)
	-rm -f $(DEPENDENCYINOBJDIR)
	-rm -f $(EXECUTABLE)
	-rm -f $(DEPENDENCY)
