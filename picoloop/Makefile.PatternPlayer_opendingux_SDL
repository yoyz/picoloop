include Makefile_sources

# GCW Zero / OpenDingux target (SDL 1.2, SDL audio). Build inside the container
# from doc/opendingux/Dockerfile - see doc/opendingux/build.md.
# Same shape as the other Makefile.PatternPlayer_* files; the toolchain is the
# 2014 GCW Zero one (GCC 4.9.1, uclibc), installed at /opt/opendingux-toolchain.
.PHONY: all clean

CC=mipsel-gcw0-linux-uclibc-g++

OD_SYSROOT=/opt/opendingux-toolchain/usr/mipsel-gcw0-linux-uclibc/sysroot


# 32 MB RAM and a 2014 compiler: keep the light engine set. The heavier engines
# (Cursynth, Open303, Twytch, MDADrum, SID, LGPT sampler, MIDI out, ER-1) are
# not built here.
SYNTH=
SYNTH+= -DENABLE_SYNTH_PICOSYNTH
SYNTH+= -DENABLE_SYNTH_PICODRUM
SYNTH+= -DENABLE_SYNTH_OPL2
SYNTH+= -DENABLE_SYNTH_PBSYNTH


CFLAGS_SDLVERS=-D__SDL12__

CFLAGS=
CFLAGS+= -c -std=c++11 -O3
CFLAGS+= -I. -I$(OD_SYSROOT)/usr/include
CFLAGS+= ${CFLAGS_SDLVERS}
CFLAGS+= -fpermissive
CFLAGS+= ${SYNTH}
CFLAGS+= -DOPENDINGUX
CFLAGS+= -D__SDL_AUDIO__
CFLAGS+= -DLINUX


LDGLAGS=
LDFLAGS+=-L$(OD_SYSROOT)/usr/lib
LDFLAGS+=-lSDL
LDFLAGS+=-lSDL_ttf
LDFLAGS+=-lSDL_gfx
LDFLAGS+=-lpthread


SOURCES=	\
			AudioDriverSDL.cpp	\
			SYSTEMLINUX.cpp		\
			$(SOURCES_PICOLOOP)     \
			$(SOURCES_PICOSYNTH) \
			$(SOURCES_PICOSYNTHUI) \
			$(SOURCES_PICODRUM) \
			$(SOURCES_PICODRUMUI) \
			$(SOURCES_DBOPL) \
			$(SOURCES_DBOPLUI) \
			$(SOURCES_PBSYNTH) \
			$(SOURCES_PBSYNTHUI)


OBJDIR             =     opendingux_sdl
OBJECTS            =   $(SOURCES:.cpp=.o)
DEPENDENCY         =   $(SOURCES:.cpp=.d)

DEPENDENCYINOBJDIR = $(addprefix $(OBJDIR)/,$(DEPENDENCY))
OBJECTSINOBJDIR    = $(addprefix $(OBJDIR)/,$(OBJECTS))

# .dge is the Dingux/OpenDingux executable that gmenu2x launches.
EXECUTABLE=PatternPlayer.dge

all: $(DEPENDENCYINOBJDIR) $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(DEPENDENCYINOBJDIR) $(OBJECTSINOBJDIR)
	$(CC) $(OBJECTSINOBJDIR) -o $@ $(LDFLAGS)

# the .d file contain the dependency
$(OBJDIR)/%.d : %.cpp %.h
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM $< -o $@

$(OBJDIR)/%.o : %.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS) $< -o $@


# include all the dependency .d file into the makefile
# it allow to match change in .h file
-include $(DEPENDENCYINOBJDIR)


# SYSTEMLINUX.d does have a .h which is SYSTEM.h, so it need a tweaks
$(OBJDIR)/SYSTEMLINUX.d:SYSTEMLINUX.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM $< -o $@

# PatternPlayer.d does have a .h which is system.h
$(OBJDIR)/PatternPlayer.d:PatternPlayer.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. -MM $< -o $@


clean:
	-rm -f $(OBJECTSINOBJDIR)
	-rm -f $(DEPENDENCYINOBJDIR)
	-rm -f $(EXECUTABLE)
