# Picoloop cross-build for RG35XX SP (aarch64 / KNULLI)
# SDL2 + SDL_ttf from the generated cross SDK, RtAudio with ALSA backend,
# RtMidi for MIDI clock.

include Makefile_sources

CROSS  := aarch64-linux-gnu-
CC     := $(CROSS)g++-14

# The cross-compilation SDK (SDL2 + SDL2_ttf + alsa-lib built for the device)
# is generated by platform/rg35xxsp/build_sdk.sh into rg35xxsp-sdk/ (gitignored).
# It is built automatically when missing; force a rebuild with
#   platform/rg35xxsp/build_sdk.sh --force
SDK      ?= $(CURDIR)/rg35xxsp-sdk
SDL_INC  := $(SDK)/usr/include
TTF_INC  := $(SDK)/usr/include
SDL_LIB  := $(SDK)/usr/lib
ALSA_INC := $(SDK)/usr/include
SDK_STAMP := $(SDK)/.stamp

SYNTH= -DENABLE_SYNTH_PICOSYNTH
SYNTH+= -DENABLE_SYNTH_PICODRUM
SYNTH+= -DENABLE_SYNTH_OPL2
SYNTH+= -DENABLE_SYNTH_PBSYNTH
SYNTH+= -DENABLE_SYNTH_LGPTSAMPLER
SYNTH+= -DENABLE_SYNTH_CURSYNTH
SYNTH+= -DENABLE_SYNTH_OPEN303
SYNTH+= -DENABLE_SYNTH_TWYTCHSYNTH
SYNTH+= -DENABLE_SYNTH_MDADRUM
SYNTH+= -DENABLE_SYNTH_SIDSYNTH
SYNTH+= -DENABLE_SYNTH_MIDIOUT
SYNTH+= -DENABLE_SYNTH_ER1

CFLAGS_SDLVERS=-D__SDL20__
CFLAGS= -c -std=c++11 -O2 -include cstdio -include cstdlib -include cstring -include string -include cmath
CFLAGS+= -I. -I$(SDL_INC) -I$(TTF_INC) -I$(ALSA_INC)
CFLAGS+= -D__LINUX__ -DLINUX -DPC_DESKTOP -DRG35XXSP
CFLAGS+= -D__RTAUDIO__
CFLAGS+= -D__RTMIDI__
CFLAGS+= -D__LINUX_ALSA__
CFLAGS+= -DSCREEN_MULT=2
CFLAGS+= -DDEBUGPRINTF
CFLAGS+= -fpermissive
CFLAGS+= ${CFLAGS_SDLVERS}
CFLAGS+= ${SYNTH}

# SDL2_ttf is built with bundled FreeType (no harfbuzz/png/bz2/z deps), so only
# SDL2, SDL2_ttf and ALSA have to be linked. -rpath-link lets the linker
# resolve SDL2_ttf's own dependencies; no rpath is recorded, so the device's
# /usr/lib copies are used at runtime (same sonames/versions).
#
# device-lib/ holds the device's own glibc (2.40) and must come first so the
# link never picks up the host toolchain's newer glibc (2.43): a binary that
# references sqrtf@GLIBC_2.43 will not start on the handheld.
LDFLAGS= -L$(SDK)/device-lib -L$(SDL_LIB)
LDFLAGS+= -Wl,-rpath-link,$(SDK)/device-lib -Wl,-rpath-link,$(SDL_LIB)
LDFLAGS+= -lSDL2_ttf -lSDL2 -lasound -lpthread -lm
# Device libstdc++ (6.0.32) only exports CXXABI_1.3.14; gcc-14 emits
# CXXABI_1.3.15. Link libstdc++/libgcc statically to avoid the version gap.
LDFLAGS+= -static-libstdc++ -static-libgcc

SOURCES= \
			RtAudio.cpp              \
			RtMidi.cpp               \
			AudioDriverRTAudio.cpp   \
			SYSTEMLINUX.cpp          \
			SysMutex.cpp             \
			PicoloopIni.cpp          \
			MidiOutSystem.cpp        \
			MidiInSystem.cpp         \
			EmbeddedAssets.cpp       \
			$(SOURCES_PICOLOOP)      \
			$(SOURCES_PICOSYNTH) \
			$(SOURCES_PICOSYNTHUI) \
			$(SOURCES_PICODRUM) \
			$(SOURCES_PICODRUMUI) \
			$(SOURCES_DBOPL) \
			$(SOURCES_DBOPLUI) \
			$(SOURCES_PBSYNTH) \
			$(SOURCES_PBSYNTHUI) \
			$(SOURCES_CURSYNTH) \
			$(SOURCES_CURSYNTHUI) \
			$(SOURCES_OPEN303) \
			$(SOURCES_OPEN303UI) \
			$(SOURCES_TWYTCH) \
			$(SOURCES_TWYTCHUI) \
			$(SOURCES_MIDIOUT) \
			$(SOURCES_MIDIOUTUI) \
			$(SOURCES_MDADRUM) \
			$(SOURCES_MDADRUMUI) \
			$(SOURCES_SIDSYNTH) \
			$(SOURCES_SIDSYNTHUI) \
			$(SOURCES_LGPTSAMPLERSYNTH) \
			$(SOURCES_LGPTSAMPLERSYNTHUI) \
			$(SOURCES_ER1) \
			$(SOURCES_ER1UI)

OBJDIR             =     rg35xxsp
OBJECTS            =   $(SOURCES:.cpp=.o)
DEPENDENCY         =   $(SOURCES:.cpp=.d)

DEPENDENCYINOBJDIR = $(addprefix $(OBJDIR)/,$(DEPENDENCY))
OBJECTSINOBJDIR    = $(addprefix $(OBJDIR)/,$(OBJECTS))

EXECUTABLE=picoloop_rg35xxsp

all: $(SDK_STAMP) $(DEPENDENCYINOBJDIR) $(SOURCES) $(EXECUTABLE)

# Generate the cross SDK (rg35xxsp-sdk/) if it is not there yet.
sdk:
	platform/rg35xxsp/build_sdk.sh

$(SDK_STAMP):
	platform/rg35xxsp/build_sdk.sh

$(EXECUTABLE): $(OBJECTSINOBJDIR) $(SDK_STAMP)
	$(CC) $(OBJECTSINOBJDIR) -o $@ $(LDFLAGS)

$(OBJDIR)/%.d : %.cpp %.h
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. $(SDL_INC:%=-I%) $(ALSA_INC:%=-I%) -MM $< -o $@

$(OBJDIR)/%.o : %.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS) $< -o $@

-include $(DEPENDENCYINOBJDIR)

$(OBJDIR)/SYSTEMLINUX.d:SYSTEMLINUX.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. $(SDL_INC:%=-I%) $(ALSA_INC:%=-I%) -MM $< -o $@

PatternPlayer.d:PatternPlayer.cpp
	@[ -d `dirname $@` ] || mkdir -p `dirname $@`
	$(CC) $(CFLAGS_SDLVERS) -std=c++11 -I. $(SDL_INC:%=-I%) $(ALSA_INC:%=-I%) -MM $< -o $@

clean:
	-rm -f $(OBJECTSINOBJDIR)
	-rm -f $(DEPENDENCYINOBJDIR)
	-rm -f $(EXECUTABLE)
	-rm -f $(DEPENDENCY)

.PHONY: all clean push run sdk

push: $(EXECUTABLE)
	adb push $(EXECUTABLE) /userdata/roms/ports/picoloop/picoloop

run: push
	adb shell "chmod +x /userdata/roms/ports/picoloop/picoloop && /userdata/roms/ports/picoloop/picoloop"