# Android build (android/) - generated/downloaded artifacts
android/local.properties
android/.gradle/
android/build/
android/*/build/
android/app/src/main/jniLibs/
android/app/build/sdl-download/
android/app/build/sdl-extracted/
android/.idea/
android/*.iml

# picoloop native Android cross-build intermediates
picoloop/build_android_*/
picoloop/libmain_*.so

# picoloop desktop build intermediates/binaries
picoloop/debian_*/
picoloop/PatternPlayer_debian_*
picoloop/picoloop_debian_*
picoloop/windows_*/
picoloop/picoloop_windows_*

# Windows SDL2 dev files fetched by platform/windows/fetch_sdl2.sh
picoloop/SDL2_windows/

# OpenDingux / GCW Zero cross build (toolchain container, see doc/opendingux/build.md)
picoloop/opendingux/
picoloop/opendingux_sdl/
picoloop/*.dge

# PSVita cross build (vitasdk container, see Makefile.PatternPlayer_psvita_SDL2)
picoloop/psvita/
picoloop/out/
picoloop/*.vpk
picoloop/*.velf
picoloop/eboot.bin
picoloop/param.sfo
picoloop/picoloop_vita.*

# PSP cross build (pspdev container, see Makefile.PatternPlayer_psp_SDL)
picoloop/psp/
picoloop/EBOOT.PBP
picoloop/PARAM.SFO
picoloop/picoloop.elf
picoloop/picoloop.prx
picoloop/picoloop_strip.elf
picoloop/picoloop.log
picoloop/picoloop.ini

# RG35XX SP cross build: object trees (container default, device-lib opt-in)
# and the generated cross SDK (only used with USE_DEVICE_LIBS=1)
picoloop/rg35xxsp/
picoloop/rg35xxsp-device/
picoloop/rg35xxsp-sdk/

# RG35XX SP container build outputs
picoloop/picoloop_sp_docker
